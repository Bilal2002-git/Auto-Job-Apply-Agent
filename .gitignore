# AutoApply-AI — Git Ignore Rules

# Sensitive environment variables — NEVER commit
.env

# SQLite database (user data — keep local)
*.db
jobs.db

# PDF files (CV and cached job docs)
*.pdf

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
.venv/
venv/
env/

# Streamlit cache
.streamlit/

# Temp files from image processing
*.tmp
*.jpg.tmp
*.png.tmp

# OS artifacts
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
