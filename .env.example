# ============================================================
# AutoApply-AI — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env to version control!
# ============================================================

# -- Gemini AI ----------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -- Telegram Bot -------------------------------------------
# Create a bot via @BotFather on Telegram and paste the token here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# -- SMTP Email (outbound dispatch) -------------------------
# Gmail: use an App Password (not your main password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password_here

# -- Candidate Info -----------------------------------------
# Your full name (used as email sender display name)
SENDER_NAME=Your Full Name

# Path to your CV/Resume PDF file
# Can be absolute or relative to the project directory
CV_PDF_PATH=./my_cv.pdf

# -- Database -----------------------------------------------
# SQLite database file path (auto-created on first run)
DB_PATH=./jobs.db
